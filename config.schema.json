{
  "pluginAlias": "AlexaSync",
  "pluginType": "platform",
  "singular": true,
  "schema": {
    "type": "object",
    "required": ["name"],
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "Alexa Sync"
      },
      "providers": {
        "title": "Providers",
        "type": "object",
        "properties": {
          "alexa": {
            "title": "Alexa account",
            "description": "Mirrors every device linked to your Alexa account (Smart Life skill, Sengled paired to Echo, etc.) into HomeKit by talking to Alexa's smart-home API with a captured session cookie. Generate the cookie by running `node scripts/alexa-login-proxy.cjs` from the plugin directory — see README.",
            "type": "object",
            "properties": {
              "amazonDomain": {
                "title": "Amazon Domain",
                "type": "string",
                "default": "amazon.com",
                "oneOf": [
                  { "title": "US (amazon.com)", "enum": ["amazon.com"] },
                  { "title": "UK (amazon.co.uk)", "enum": ["amazon.co.uk"] },
                  { "title": "DE (amazon.de)", "enum": ["amazon.de"] },
                  { "title": "CA (amazon.ca)", "enum": ["amazon.ca"] },
                  { "title": "AU (amazon.com.au)", "enum": ["amazon.com.au"] }
                ]
              },
              "pollInterval": { "title": "Poll Interval (seconds)", "type": "number", "default": 60, "minimum": 15, "description": "The poll loop ticks every 15s, so values below 15 behave the same as 15." },
              "cookieRefreshDays": { "title": "Cookie Refresh Interval (days)", "type": "number", "default": 14 },
              "deviceTypes": {
                "title": "Device Types to Import",
                "type": "array",
                "items": { "type": "string" },
                "default": ["LIGHT", "SWITCH", "SMARTPLUG", "SMARTLOCK", "FAN", "THERMOSTAT"]
              }
            }
          }
        }
      }
    }
  }
}
