{
  "name": "homebridge-alexa-sync",
  "displayName": "Alexa Sync",
  "version": "0.1.7",
  "description": "Homebridge plugin that mirrors Alexa-linked smart-home devices (Smart Life, Sengled, Resideo, etc.) into HomeKit. Cookie-based; no Tuya developer subscription required for the common Smart Life path. Part of the Switchboard smart-home family.",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist/",
    "config.schema.json",
    "alexa-lambda/",
    "scripts/",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "homebridge-plugin",
    "alexa",
    "smart-life",
    "smart-home",
    "homekit",
    "two-way",
    "switchboard"
  ],
  "author": "John Carroll (@johnccarroll)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/johnccarroll/homebridge-alexa-sync.git"
  },
  "bugs": {
    "url": "https://github.com/johnccarroll/homebridge-alexa-sync/issues"
  },
  "homepage": "https://github.com/johnccarroll/homebridge-alexa-sync#readme",
  "engines": {
    "node": "^20.15.1 || ^22 || ^24",
    "homebridge": "^1.8.0 || ^2.0.0-beta.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "^8.18.1",
    "homebridge": "^2.0.0-beta.89",
    "rimraf": "^6.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.104.1",
    "alexa-cookie2": "^5.0.3",
    "alexa-remote2": "^8.0.4",
    "tuyapi": "^7.7.1",
    "ws": "^8.20.0"
  }
}
